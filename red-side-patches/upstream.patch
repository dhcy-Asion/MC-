+// Isolate each native stage in its own fault guard. The result/vector lives
+// outside the guards; after a loader/metadata/read fault a captured handler can
+// still be released once. These are the existing GameReadFile ABIs above.
+struct ResourceProbeBackend {
+    const std::string& path;
+    alignas(16) uint8_t pathObj[64] = { 0 };
+    void* handler = nullptr;
+    uintptr_t worker = 0;
+    uint32_t stored = 0, decoded = 0;
+    uint8_t flags = 0;
+    bool releaseAttempted = false;
+    bool HasHandler() const noexcept { return handler != nullptr; }
+    bool Load() noexcept {
+        CDK_GUARD_BEGIN
+            auto sdAlloc = (uintptr_t(*)(int))(g_base + kRva_StringDataAlloc);
+            auto normalize = (void*(*)(void*, const void*))(g_base + kRva_PathNormalizeCtor);
+            uintptr_t sd = sdAlloc((int)path.size()); if (!sd) return false;
+            strncpy_s((char*)*(uintptr_t*)sd, path.size() + 1, path.c_str(), _TRUNCATE);
+            uintptr_t holder = sd; normalize(pathObj, &holder);
+            g_origResLoad(g_resLoader, &handler, pathObj, 0);
+            return true;
+        CDK_GUARD_FAIL return false;
+        CDK_GUARD_END
+    }
+    bool Metadata(uint32_t& s, uint32_t& d, uint32_t& f) noexcept {
+        CDK_GUARD_BEGIN
+            const uintptr_t h = (uintptr_t)handler;
+            worker = *(uintptr_t*)(h + 0x20);
+            stored = *(uint32_t*)(h + 0x34); decoded = *(uint32_t*)(h + 0x38);
+            flags = *(uint8_t*)(h + 0x3c);
+            s = stored; d = decoded; f = flags; return true;
+        CDK_GUARD_FAIL return false;
+        CDK_GUARD_END
+    }
+    bool Read(uint8_t* bytes, uint32_t capacity) noexcept {
+        const uint32_t need = (flags & 15) == 1 ? stored : decoded;
+        const uint32_t cap = stored > decoded ? stored : decoded;
+        if (!worker || !need || !cap || stored > mc_resource_probe::MAX_BYTES ||
+            decoded > mc_resource_probe::MAX_BYTES || capacity != cap) return false;
+        CDK_GUARD_BEGIN
+            auto read5 = *(uint8_t(__fastcall**)(void*, void*, void*, uint32_t, uint32_t, uint32_t))(*(uintptr_t*)worker + 0x28);
+            return read5((void*)worker, handler, bytes, capacity, 0, 0) != 0;
+        CDK_GUARD_FAIL return false;
+        CDK_GUARD_END
+    }
+    bool Release() noexcept {
+        if (!handler || releaseAttempted) return false;
+        releaseAttempted = true; // Native release can itself fault; never retry.
+        CDK_GUARD_BEGIN
+            (*(void(__fastcall**)(void*, int))(*(uintptr_t*)handler))(handler, 1);
+            return true;
+        CDK_GUARD_FAIL return false;
+        CDK_GUARD_END
+    }
+};
