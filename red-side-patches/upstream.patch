+    if (method == "GET" && path == "/api/prototype/render-camera") {
+        Vec3 p{}, r{}, u{}, f{}; float m00 = 0, m11 = 0;
+        if (!core::RenderCamera(&p, &r, &u, &f, &m00, &m11)) {
+            status = 503; return Error("renderer camera unavailable");
+        }
+        auto vec = [](Vec3 v) { return "{\"x\":" + Num(v.x) + ",\"y\":" + Num(v.y) + ",\"z\":" + Num(v.z) + "}"; };
+        return "{\"position\":" + vec(p) + ",\"right\":" + vec(r) + ",\"up\":" + vec(u) +
+            ",\"forward\":" + vec(f) + ",\"m00\":" + Num(m00) + ",\"m11\":" + Num(m11) + "}";
+    }
+    if (method == "POST" && path == "/api/prototype/ground-probe") {
+        std::string failure; if (!Ready(status, failure)) return failure;
+        float x = 0, y = 0, z = 0, len = 10;
+        if (!Number(arg, "x", x, true) || !Number(arg, "y", y, true) || !Number(arg, "z", z, true) ||
+            !Number(arg, "length", len) || len <= 0 || len > 100) {
+            status = 400; return Error("finite x/y/z and length in (0,100] required");
+        }
+        const int ticket = core::GroundProbe({x, y, z}, len);
+        if (!ticket) { status = 503; return Error("ground probe not ready; enter the world and walk a few steps"); }
+        status = 202; return "{\"ticket\":" + Int(ticket) + "}";
+    }
+    if (method == "GET" && path == "/api/prototype/ground-result") {
+        float ticket = 0;
+        if (!Number(arg, "ticket", ticket, true) || ticket <= 0 || ticket > 2147483646 || floorf(ticket) != ticket) {
+            status = 400; return Error("positive integer ticket required");
+        }
+        core::GroundHit hit{};
+        const auto st = core::GroundResultState((int)ticket, &hit);
+        if (st == core::GroundProbeStatus::Pending) { status = 202; return "{\"state\":\"pending\"}"; }
+        if (st == core::GroundProbeStatus::Invalidated || st == core::GroundProbeStatus::Unknown) {
+            status = 410; return Error("probe invalidated or expired; discard the action");
+        }
+        if (st == core::GroundProbeStatus::Miss) return "{\"state\":\"miss\"}";
+        return "{\"state\":\"hit\",\"x\":" + Num(hit.center.x) + ",\"y\":" + Num(hit.centerY - hit.radius) +
+            ",\"z\":" + Num(hit.center.z) + "}";
+    }
     if (method == "GET" && path == "/api/camera") {
