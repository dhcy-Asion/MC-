+// CrimsonMC atomic object preconditions. Never call the legacy Hide/Forget paths:
+// they can defer a UID-only mutation beyond the snapshot that authorized it.
+const char* ConditionalObjectMutation(int uid, const ObjectExpected& expected, const std::string* project) {
+    uintptr_t object = 0; int oldProject = 0;
+    {
+        // Names precede registry access everywhere; ground admission precedes registry.
+        // No engine call, queue dispatch or project helper runs while these locks are held.
+        std::lock_guard<std::mutex> names(g_projMutex);
+        std::lock_guard<std::mutex> operation(g_groundOpMutex);
+        REG_LOCK;
+        if (!GameThreadReady()) return "busy";
+        if (g_groundWorldWriting || g_groundLeases.count(uid) || g_groundMutationPending.count(uid)) return "busy";
+        for (auto& w : g_groundOps) if (auto op = w.lock())
+            if (!op->view.terminal() && GroundTouches(op, { uid })) return "busy";
+        const int index = IndexOfUidLocked(uid);
+        if (index < 0) return "object_changed";
+        SpawnedObj& e = g_reg[(size_t)index];
+        // ObjectJson emits nine significant digits: its finite float32 values round
+        // trip exactly. A later move by even one float ULP must reject the old read.
+        if (e.proj < 0 || e.proj >= (int)g_projNames.size() || g_projNames[(size_t)e.proj] != expected.project ||
+            e.prefab != expected.prefab || e.hidden != expected.hidden ||
+            e.pos.x != expected.pos.x || e.pos.y != expected.pos.y || e.pos.z != expected.pos.z ||
+            e.rot.yaw != expected.rot.yaw || e.rot.pitch != expected.rot.pitch || e.rot.roll != expected.rot.roll ||
+            e.scale != expected.scale) return "object_changed";
+        if (e.prefab != "/object/00_common/system/cd_testfield_grid_box_1m.prefab" ||
+            e.gimmick || e.standin || e.actor || e.placeRow != -1 || !e.placeReq.expired() || (e.hidden && e.obj)) return "unsupported";
+        // Assignment of an ordinary pending spawn is safe: DoSpawn's attachment
+        // preserves its current project. A visible pending delete waits for obj.
+        if (!project && !e.hidden && !e.obj) return "busy";
+        // A legacy move can own the old handle outside REG_LOCK in DoReplace.
+        // Its poseGen is incremented before dispatch; do not risk a second remove.
+        if (!project && e.poseGen) return "unsupported";
+        oldProject = e.proj;
+        if (project) {
+            int id = 0;
+            if (!project->empty()) {
+                for (size_t i = 1; i < g_projNames.size(); ++i) if (_stricmp(g_projNames[i].c_str(), project->c_str()) == 0) { id = (int)i; break; }
+                if (!id) { g_projNames.push_back(*project); id = (int)g_projNames.size() - 1; }
+            }
+            e.proj = id; MarkDirtyLocked(oldProject); MarkDirtyLocked(id);
+        } else {
+            object = e.obj; e.hidden = true; e.obj = 0; e.gen = NewGenLocked();
+            MarkDirtyLocked(oldProject); ForgetCopyValueLocked(uid);
+            g_reg.erase(g_reg.begin() + index); // queued UID/generation work can no longer attach
+        }
+    }
+    if (object) {
+        auto work = TrackProjectNativeWork(oldProject);
+        RunOnGameThread([object, work]() { DoRemove(object); });
+    }
+    return nullptr;
+}
